{
  "name": "krishna-jewellers-backend",
  "version": "3.0.0",
  "description": "Serverless REST API for Krishna Jewellers (Vercel + Neon + Cloudinary)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
